<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore preferences live under files/datastore/, not shared_prefs. -->
        <exclude domain="file" path="datastore/"/>
        <exclude domain="database" path="photo_database"/>
        <exclude domain="database" path="photo_database-shm"/>
        <exclude domain="database" path="photo_database-wal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="database" path="photo_database"/>
        <exclude domain="database" path="photo_database-shm"/>
        <exclude domain="database" path="photo_database-wal"/>
    </device-transfer>
</data-extraction-rules>
